# Priority Guardian - Environment Variables
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=priority-guardian
ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/priority_guardian

# Security Settings
ENCRYPTION_KEY=your-fernet-key-here-generate-with-Fernet.generate_key()

# Google OAuth Settings
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Webhook Settings
WEBHOOK_RENEWAL_THRESHOLD_HOURS=48
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400
WEBHOOK_RENEWAL_THROTTLE_SECONDS=86400
WEBHOOK_NEEDS_SYNC_TTL_SECONDS=300

# OAuth Provider Settings (Increment 7A)
# Generate keys with: python scripts/generate_oauth_keys.py
OAUTH_RSA_PRIVATE_KEY=your-base64-encoded-private-key-here
OAUTH_RSA_PUBLIC_KEY=your-base64-encoded-public-key-here
OAUTH_JWT_KID=focused-2025-11
OAUTH_ISSUER=http://localhost:8000
OAUTH_TOKEN_EXPIRY_SECONDS=3600
OAUTH_REFRESH_TOKEN_EXPIRY_DAYS=30
