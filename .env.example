# Application
DEBUG=false
LOG_LEVEL=INFO
DOMAIN=https://www.priority-guard.com

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/priority_guardian
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# OAuth Provider (for ChatGPT)
OAUTH_CLIENT_ID=your_chatgpt_client_id
OAUTH_CLIENT_SECRET=your_chatgpt_client_secret
OAUTH_TOKEN_EXPIRY=3600

# Google OAuth Client
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.priority-guard.com/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALLOWED_ORIGINS=["https://chat.openai.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
